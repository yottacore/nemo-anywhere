# Shell scripts must stay LF so they run under MSYS2 bash on Windows too
# (autocrlf would otherwise hand them CRLF on a Windows checkout and break them).
*.bash text eol=lf
*.sh   text eol=lf
cicd/win/msys2-pins.txt text eol=lf

# Git hooks are shell too, just without an extension to match on. So is the launcher
# wrapper, which has to be named for the command it stands in for.
cicd/hooks/* text eol=lf
utility/runfm text eol=lf

# The cross-platform pwsh scripts carry a shebang and run on unix as well, where
# CRLF would send the kernel looking for an interpreter named 'pwsh\r'.
*.ps1 text eol=lf

# Batch is the other way round - CRLF is what cmd.exe expects.
*.cmd text eol=crlf

# gen-theme-resources.py writes LF, so a CRLF checkout leaves the manifest looking
# modified after every regeneration even when nothing in it changed.
source/gresources/nemo-themes.gresource.xml text eol=lf

# Vendored theme art - keep bytes stable, no EOL conversion.
*.svg -text
*.png -text
*.ico -text

# Fuzz seeds are bytes, whatever they look like. A CRLF checkout would change them.
source/fuzz/corpus/** -text

# The GTK settings and font config copied into every Windows bundle. The zip is
# made on Linux and the single exe on Windows, and both have to get the same bytes.
cicd/win/bundle-etc/** text eol=lf
