field: search.disabled-search-helpers
	type: string-array
	desc: Content-search helpers to skip

field: search.group-by-folder
	type: bool
	default: false
	desc: Group results under the folder holding them instead of one flat list

field: search.search-content-case-sensitive
	type: bool
	default: false

field: search.search-content-use-raw
	type: bool
	default: false
	desc: Match content as raw bytes rather than text

field: search.search-content-use-regex
	type: bool
	default: false

field: search.search-file-case-sensitive
	type: bool
	default: false

field: search.search-files-recursively
	type: bool
	default: true

field: search.search-files-use-regex
	type: bool
	default: false

field: search.search-regex-format
	type: string
	default: pcre
	desc: Regex flavor: pcre or javascript

field: search.search-reverse-sort
	type: bool
	default: false

field: search.search-skip-folders
	type: string-array
	default: /dev, /proc, /sys, dosdevices, .git
