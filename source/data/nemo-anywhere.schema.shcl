field: preferences.size-prefixes
	type: string
	allowed: base-10, base-10-full, base-2, base-2-full
	default: base-2
	desc: Whether sizes count in 1024s or 1000s

field: preferences.sort-directories-first
	type: bool
	default: true

field: preferences.sort-favorites-first
	type: bool
	default: true

field: preferences.start-with-dual-pane
	type: bool
	default: false

field: preferences.swap-trash-delete
	type: bool
	default: false
	desc: Swap the Trash and Delete keys

field: preferences.tab-width-max-percent
	type: int
	default: 25
	desc: Widest a tab may get, as a percentage of the tab strip

field: preferences.tab-width-min-percent
	type: int
	default: 10
	desc: Narrowest a tab may get, as a percentage of the tab strip

field: preferences.tabs-open-position
	type: string
	allowed: after-current-tab, end
	default: after-current-tab
	desc: Where a new tab goes

field: preferences.thumbnail-limit
	type: int
