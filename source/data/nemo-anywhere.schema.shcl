field: windows.allow-slash-input
	type: bool
	default: true
	desc: Accept a forward slash as a separator in a typed location

field: windows.show-dot-files
	type: bool
	default: false
	desc: Show files whose name starts with a dot. Separate from the Windows hidden flag.

field: windows.use-search-index
	type: bool
