# Schema for the nemo-anywhere config file.
# Declares every setting's type, default and (where closed) allowed values.
# Plain SHCL - nothing compiles it. See vendor/shcl for the language.

field: favorites
	type: string-array

field: favorites-root-metadata
	type: string-array

field: appearance.gtk-theme
	type: string
	default: 
	desc: Widget theme name, or empty for the platform's own

field: appearance.icon-theme
	type: string
	default: 
	desc: Icon theme name, or empty for the platform's own

field: appearance.mode
	type: string
	allowed: system, light, dark
	default: system

field: archive.create-with-7z
	type: string
	default: "{{PROGRAM}} a {{FORMAT}} {{LEVEL}} {{THREADS}} -y -bsp1 -spd {{PASSWORD}} {{SPLIT}} {{SOLID}} {{LINKS}} -- {{TARGET_ARCHIVE}} {{SOURCE_ITEMS}}"
	desc: Command line 7-Zip is run with to create an archive. Each {{NAME}} stands for something the Compress dialog fills in; drop one and that option stops working. Base flags only, which the app adds to or changes as a job needs; edit only to suit a different version of the program. Empty the line for the built-in one.

field: archive.create-with-rar
	type: string
	default: "{{PROGRAM}} a {{LEVEL}} {{THREADS}} -r -y {{PASSWORD}} {{SPLIT}} {{SOLID}} {{DEDUPE}} {{RECOVERY}} {{LOCK}} {{LINKS}} -- {{TARGET_ARCHIVE}} {{SOURCE_ITEMS}}"
	desc: Command line rar is run with to create an archive. Same placeholders as the 7-Zip line, plus {{DEDUPE}}, {{RECOVERY}} and {{LOCK}}, which only rar has. Base flags only, which the app adds to or changes as a job needs; edit only to suit a different version of the program.

field: archive.extract-with-7z
	type: string
	default: "{{PROGRAM}} x -y -bsp1 -spd {{PASSWORD}} -o{{TARGET_FOLDER}} -- {{SOURCE_ARCHIVE}}"
	desc: Command line 7-Zip is run with to unpack an archive. Base flags only, which the app adds to or changes as a job needs; edit only to suit a different version of the program. Empty the line for the built-in one.

field: archive.extract-with-rar
	type: string
	default: "{{PROGRAM}} x -y {{PASSWORD}} -- {{SOURCE_ARCHIVE}} {{TARGET_FOLDER_WITH_SEPARATOR}}"
	desc: Command line rar or unrar is run with to unpack an archive. Base flags only, which the app adds to or changes as a job needs; edit only to suit a different version of the program. Empty the line for the built-in one.

field: archive.last-each
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-encrypt-names
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-dedupe
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-follow-links
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-format
	type: string
	default: zip
	desc: What the Compress dialog starts from next time

field: archive.last-level
	type: int
	default: 5
	desc: What the Compress dialog starts from next time

field: archive.last-lock
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-recovery
	type: bool
	default: true
	desc: What the Compress dialog starts from next time

field: archive.last-solid
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-split
	type: bool
	default: false
	desc: What the Compress dialog starts from next time

field: archive.last-split-size
	type: string
	default: "2 GiB"
	desc: What the Compress dialog starts from next time

field: archive.last-store-links
	type: bool
	default: true
	desc: What the Compress dialog starts from next time

field: compact-view.all-columns-have-same-width
	type: bool
	default: false

field: compact-view.default-icon-size
	type: int
	default: 100
	desc: Icon size as a per cent of the standard 64 pixels

field: debug.testguard-all-deletes
	type: bool
	default: true
	desc: Ask before every trash and delete, naming the code that asked. Scaffolding for finding a removal nothing accounts for

field: file-cache.max-size-gib
	type: float
	default: 2
	desc: Largest the file cache may get, in GiB. The least recently drawn thumbnails go first. 0 for no limit

field: file-cache.memory-gib
	type: float
	default: 1
	desc: Most memory the thumbnails held ready to draw may take, in GiB. Past it only those near the view are held. 0 holds only what is on screen

field: file-cache.max-age-days
	type: int
	default: 180
	desc: Drop a thumbnail not drawn for this many days. 0 to keep them however old

field: file-cache.drop-missing
	type: bool
	default: true
	desc: Forget a local file that is gone from a folder that is still there. A folder that is missing entirely is left alone, since it may be on a drive that is not plugged in

field: file-cache.save-checksum
	type: bool
	default: false
	desc: Write each checksum onto the file it belongs to, as the extended attributes user.blake3.b64u, .bytes and .mtime. On Windows these are alternate data streams, which only local NTFS and ReFS drives keep

field: file-cache.prune-min-hours
	type: int
	default: 4
	desc: Soonest the file cache is cleaned up again. The next time is picked at random between this and prune-max-hours

field: file-cache.prune-max-hours
	type: int
	default: 24
	desc: Latest the file cache is cleaned up again

field: file-cache.prune-idle-minutes
	type: int
	default: 5
	desc: Wait until no thumbnails have been drawn for this many minutes before cleaning up. 0 to not wait

field: interface.clock-use-24h
	type: bool
	default: true

field: media-handling.automount
	type: bool
	default: false

field: media-handling.automount-open
	type: bool
	default: false
	desc: Open a window on media as soon as it is mounted

field: performance.clone-min-kib
	type: int
	default: 64
	desc: Files smaller than this are copied in full rather than cloned, on file systems that can clone. 0 to always clone, 1024 at most

field: performance.cpu-percent
	type: int
	default: 50
	desc: Share of the machine's CPU cores compression may use

field: privacy.remember-recent-files
	type: bool
	default: true

field: terminal.exec
	type: string
	default: ""
	desc: Terminal used for Open in Terminal, or empty to let the system pick

field: terminal.exec-arg
	type: string
	default: -e
	desc: Argument that terminal takes before a command

field: desktop.show-desktop-icons
	type: bool
	default: true

field: desktop.text-ellipsis-limit
	type: int
	default: 2
	desc: Lines of a name under a desktop icon before it is cut short

field: desktop.use-desktop-grid
	type: bool
	default: true

field: icon-view.captions
	type: string-array
	default: none, size, date_modified
	desc: Extra details shown under an icon

field: icon-view.default-icon-size
	type: int
	default: 100
	desc: Icon size as a per cent of the standard 64 pixels

field: icon-view.default-image-icon-size
	type: int
	default: 500
	desc: Icon size for a folder that is mostly images, as a per cent of the standard 64 pixels

field: icon-view.image-folder-min-images
	type: int
	default: 2
	desc: Fewest images a folder needs to count as mostly images

field: icon-view.image-folder-min-percent
	type: int
	default: 50
	desc: Share of a folder's files, sub-folders not counted, that must be images for it to count as mostly images

field: icon-view.image-folder-switch
	type: bool
	default: true
	desc: Show a folder that is mostly images in icon view, unless it has a view of its own

field: icon-view.labels-beside-icons
	type: bool
	default: false

field: icon-view.text-ellipsis-limit
	type: string-array
	default: 3
	desc: Lines of a name under an icon before it is cut short

field: icon-view.thumbnail-size
	type: int
	default: 64
	desc: Thumbnail size in pixels

field: list-view.column-fit-percent
	type: int
	default: 90
	desc: Share of the values Name and Location still show when the row is short of room, and the share other variable columns show by default. Name counts every file; the others count each distinct value once.

field: list-view.default-column-order
	type: string-array
	default: name, where, size, extension, type, date_modified, owner, owner_name, owner_and_name, group, permissions

field: list-view.default-visible-columns
	type: string-array
	default: name, size, extension, type, date_modified, owner, group, permissions

field: list-view.default-icon-size
	type: int
	default: 75
	desc: Icon size as a per cent of the standard 64 pixels

field: list-view.enable-folder-expansion
	type: bool
	default: true
	desc: Let a folder be expanded in place to show what is in it

field: list-view.row-hover-color
	type: string
	default: 
	desc: Color of the row under the pointer, in any form CSS takes. Empty uses the theme's nemo_row_hover color, or a faint tint of the selection color if it has none. transparent turns it off

field: list-view.row-shading
	type: bool
	default: false
	desc: Shade every other row

field: list-view.row-shading-color
	type: string
	default: 
	desc: Color of the shaded rows, in any form CSS takes. Empty uses the theme's nemo_row_shading color, or a faint tint of the text color if it has none

field: plugins.disabled-actions
	type: string-array
	default: 90_new-launcher.nemo_action, 90_new-workspace.nemo_action, 91_delete-workspace.nemo_action, 92_show-expo.nemo_action, add-desklets.nemo_action, change-background.nemo_action, set-as-background.nemo_action, set-resolution.nemo_action
	desc: Action files that are switched off. The shipped Cinnamon-only ones start here

field: plugins.disabled-extensions
	type: string-array

field: plugins.disabled-scripts
	type: string-array

field: preferences.always-show-tabs
	type: bool
	default: false
	desc: Show the tab strip even with only one tab

field: preferences.always-use-browser
	type: bool
	default: true
	desc: Every window is a browser window, with a toolbar and history

field: preferences.bulk-rename-tool
	type: string
	default: ""
	desc: Program run for a bulk rename

field: preferences.click-double-parent-folder
	type: bool
	default: false
	desc: Double-clicking empty space goes to the parent folder

field: preferences.click-policy
	type: string
	allowed: single, double
	default: double
	desc: One click or two to open a file

field: preferences.close-device-view-on-device-eject
	type: bool
	default: false
	desc: Close the window when its device is ejected, rather than going home

field: preferences.confirm-drag-copy
	type: bool
	default: false
	desc: Ask before a drop copies files

field: preferences.confirm-drag-move
	type: bool
	default: true
	desc: Ask before a drop moves files

field: preferences.confirm-move-to-trash
	type: bool
	default: true

field: preferences.confirm-trash
	type: bool
	default: true
	desc: Ask before deleting outright or emptying the Trash

field: preferences.confirm-many-items
	type: int
	default: 20
	desc: Ask before trashing or deleting this many items at once, whatever the two above say (0 for never)

field: preferences.date-format
	type: string
	allowed: locale, iso, informal
	default: iso

field: preferences.default-folder-viewer
	type: string
	allowed: icon-view, compact-view, list-view
	default: list-view

field: preferences.default-sort-in-reverse-order
	type: bool
	default: false

field: preferences.default-sort-order
	type: string
	allowed: manually, name, size, type, detailed_type, mtime, atime, trash-time
	default: name

field: preferences.deferred-attribute-preload-limit
	type: int
	default: 150
	desc: How many files a folder reads extra details for up front

field: preferences.desktop-is-home-dir
	type: bool
	default: false

field: preferences.detect-content
	type: bool
	default: false
	desc: Look inside mounted media to suggest a program for it

field: preferences.disable-menu-warning
	type: bool
	default: false
	desc: Skip the explanation shown when the menu bar is turned off

field: preferences.enable-delete
	type: bool
	default: true
	desc: Offer Delete, which skips the Trash

field: preferences.enable-mime-actions-make-executable
	type: bool
	default: false
	desc: Offer to make an unknown file executable and run it

field: preferences.executable-text-activation
	type: string
	allowed: launch, display, ask
	default: ask
	desc: What opening an executable text file does

field: preferences.expand-row-on-dnd-dwell
	type: bool
	default: true
	desc: Hovering a folder during a drag opens it

field: preferences.image-viewers-with-external-sort
	type: string-array
	default: xviewer, feh, sxiv
	desc: Image viewers that are told the current sort order

field: preferences.inherit-view-settings
	type: bool
	default: true
	desc: A folder with nothing saved uses the settings of the nearest parent folder that has some

field: preferences.inherit-show-thumbnails
	type: bool
	default: true
	desc: A folder shows thumbnails if its parent did

field: preferences.last-server-connect-method
	type: int
	default: 2

field: preferences.mouse-back-button
	type: int
	default: 8
	desc: Mouse button that goes back

field: preferences.mouse-forward-button
	type: int
	default: 9
	desc: Mouse button that goes forward

field: preferences.mouse-use-extra-buttons
	type: bool
	default: true
	desc: Use the extra mouse buttons for back and forward

field: preferences.never-queue-file-ops
	type: bool
	default: false
	desc: Start every file operation at once rather than queueing them

field: preferences.remember-folder-settings
	type: bool
	default: false
	desc: Each folder keeps its own view, zoom, sort and columns

field: preferences.rename-selects-whole-name
	type: bool
	default: true
	desc: Renaming selects the whole name, extension included

field: preferences.quick-renames-with-pause-in-between
	type: bool
	default: false
	desc: Two slow clicks on a name start a rename

field: preferences.show-advanced-permissions
	type: bool
	default: false

field: preferences.show-bookmarks-in-to-menus
	type: bool
	default: true
	desc: List bookmarks in the Move To and Copy To menus

field: preferences.show-compact-view-icon-toolbar
	type: bool
	default: true

field: preferences.show-computer-icon-toolbar
	type: bool
	default: false

field: preferences.show-directory-item-counts
	type: string
	allowed: always, local-only, never
	default: local-only
	desc: When to count what is in a folder

field: preferences.show-edit-icon-toolbar
	type: bool
	default: true
	desc: Show the button that swaps the path buttons for a typed location

field: preferences.show-full-path-titles
	type: bool
	default: false
