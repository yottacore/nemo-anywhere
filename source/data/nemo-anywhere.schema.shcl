	desc: Largest image a thumbnail is made for, in bytes

field: preferences.thumbnail-threads
	type: int
	default: -1
	desc: Threads used to make thumbnails, -1 for half the processors. Takes effect on restart.

field: preferences.tooltips-in-icon-view
	type: bool
	default: false

field: preferences.tooltips-in-list-view
	type: bool
	default: false

field: preferences.tooltips-show-access-date
	type: bool
