# nemo-build: the day-to-day Linux DEV build box (Debian 13 / trixie).
#
# Matches the host distro, so a build here behaves like a build on the box, but
# in a clean pinned image rather than against whatever the host has drifted to.
# Release artifacts do NOT come from here - see Dockerfile (Ubuntu 22.04) for
# why, and never cut a release from this image.
#
# Source tree is mounted at /src; builds go to /build.
#
# Run it with --shm-size=2g or parallel gcc ICEs on the default 64M /dev/shm.
# Each test runs in a bubblewrap jail (jail.bash), which needs
# --security-opt seccomp=unconfined --security-opt apparmor=unconfined too.
#
# Pinned: the base by digest (trixie, 2026-07-13), and apt reads the archive,
# security and debug archives included, from snapshot.debian.org as they stood
# at 2026-10-19 22:00 UTC, the last time the old hand-made image was updated.
# Move the snapshot on purpose, and the digest with it when the base moves.
# Snapshot Release files are past their Valid-Until, which apt would refuse;
# every index and package is still checked against the signed InRelease.
# docker-run.bash tags the image by a hash of this file and builds it the first
# time that hash is seen.

FROM debian:trixie@sha256:fac46bff2e02f51425b6e33b0e1169f55dfb053d83511ca28aa50c09fd5ed7a4

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i -E 's#http://deb\.debian\.org/(debian(-security)?)$#http://snapshot.debian.org/archive/\1/20261019T220000Z#' /etc/apt/sources.list.d/debian.sources \
	&& echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/80snapshot \
	&& apt-get update && apt-get install -y --no-install-recommends \
		meson ninja-build gcc pkg-config gettext intltool itstool \
		clang llvm libclang-rt-dev gdb \
		gobject-introspection libgirepository1.0-dev python3-gi \
		libgtk-3-dev libglib2.0-dev libglib2.0-bin libglib2.0-dev-bin \
		libpango1.0-dev libatk1.0-dev libgail-3-dev \
		libjson-glib-dev libexempi-dev libexif-dev libarchive-dev \
		libsqlite3-dev \
		libx11-dev libxext-dev libxrender-dev \
		xvfb xauth x11-utils xdotool openbox imagemagick dbus \
		p7zip-full sqlite3 bubblewrap \
	&& rm -rf /var/lib/apt/lists/*

# The sanitizer lane's suppressions name functions inside fontconfig and GTK,
# and a leak report only has those names with the debug symbols. Each dbgsym
# package wants the exact version installed above.
RUN printf '%s\n' 'Types: deb' 'URIs: http://snapshot.debian.org/archive/debian-debug/20261019T220000Z' \
		'Suites: trixie-debug trixie-proposed-updates-debug' 'Components: main' \
		'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' \
		> /etc/apt/sources.list.d/debian-debug.sources \
	&& apt-get update && apt-get install -y --no-install-recommends \
		libfontconfig1-dbgsym libgtk-3-0t64-dbgsym \
	&& rm -rf /var/lib/apt/lists/*

# p7zip is here so the 7-Zip backend can be exercised rather than only the
# libarchive one - without it the Compress dialog offers 7z with none of the
# options that backend brings. rar is not packaged for Debian, so the rar
# backend still cannot be driven from in here.

WORKDIR /src
