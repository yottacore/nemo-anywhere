# nemo-lint: the lint tools at fixed versions, so a finding comes from the code
# and not from whichever shellcheck or cppcheck a box happens to have.
#
# Built and run by cicd/utility/include/lint-image.bash, tagged by a hash of
# this file, so any edit here builds a new image on the next lint run.
# The repo is mounted at its own host path, not /src, so a worktree's .git
# file still points somewhere real.
#
# shellcheck publishes no checksum; its hash is the one first downloaded.

FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
		bash git gawk jq xz-utils unzip curl ca-certificates \
		python3 python3-venv \
		libicu76 libssl3t64 zlib1g libgssapi-krb5-2 \
	&& rm -rf /var/lib/apt/lists/*

ARG SHELLCHECK_VER=0.11.0
ARG SHELLCHECK_SHA=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
RUN curl -fsSL -o /tmp/sc.tar.xz https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VER}/shellcheck-v${SHELLCHECK_VER}.linux.x86_64.tar.xz \
	&& echo "${SHELLCHECK_SHA}  /tmp/sc.tar.xz" | sha256sum -c - \
	&& tar -xJf /tmp/sc.tar.xz -C /tmp \
	&& install -m 755 /tmp/shellcheck-v${SHELLCHECK_VER}/shellcheck /usr/local/bin/shellcheck \
	&& rm -rf /tmp/sc.tar.xz /tmp/shellcheck-v${SHELLCHECK_VER}

ARG PWSH_VER=7.6.6
ARG PWSH_SHA=ddbc4a2d113bbd46d283cfedcbcd117a70caefd7673f41f2b4e0000badf103bc
RUN curl -fsSL -o /tmp/pwsh.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VER}/powershell-${PWSH_VER}-linux-x64.tar.gz \
	&& echo "${PWSH_SHA}  /tmp/pwsh.tar.gz" | sha256sum -c - \
	&& mkdir -p /opt/microsoft/powershell/7 \
	&& tar -xzf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7 \
	&& chmod 755 /opt/microsoft/powershell/7/pwsh \
	&& ln -s /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh \
	&& rm /tmp/pwsh.tar.gz

# From the gallery as a plain zip, so it can be checked like the rest. The
# compatibility profiles are 279 MB and only the UseCompatible* rules read
# them, which PSScriptAnalyzerSettings.psd1 doesn't turn on.
ARG PSA_VER=1.25.0
ARG PSA_SHA=14e634c828eb98efb9f40b2918ba90f139ed5eccdf663a2a747736d996995d60
RUN curl -fsSL -o /tmp/psa.zip https://www.powershellgallery.com/api/v2/package/PSScriptAnalyzer/${PSA_VER} \
	&& echo "${PSA_SHA}  /tmp/psa.zip" | sha256sum -c - \
	&& dir=/opt/microsoft/powershell/7/Modules/PSScriptAnalyzer/${PSA_VER} \
	&& mkdir -p "$dir" \
	&& unzip -q /tmp/psa.zip -d "$dir" -x '_rels/*' 'package/*' '[[]Content_Types[]].xml' 'compatibility_profiles/*' \
	&& rm /tmp/psa.zip

RUN python3 -m venv /opt/lint \
	&& printf '%s\n' \
		'cppcheck==1.5.1 --hash=sha256:ca87f5ed64386a40aaf156f295eac4efa6a7a819dd0415eb2d11577572e89405' \
		'importlib_metadata==9.0.0 --hash=sha256:2d21d1cc5a017bd0559e36150c21c830ab1dc304dedd1b7ea85d20f45ef3edd7' \
		'zipp==4.1.0 --hash=sha256:25ad4e16390cd314347dd8f1de67a2ac538ae658ed4ab9db16029c07c188e97f' \
		'ruff==0.15.22 --hash=sha256:365523eb91d9224e1bcb03b022fbf0facb8f9e23792a2c53d9d4b3924bdbdebb' \
		> /tmp/req.txt \
	&& /opt/lint/bin/pip install -q --no-cache-dir --no-deps --require-hashes -r /tmp/req.txt \
	&& ln -s /opt/lint/bin/cppcheck /opt/lint/bin/ruff /usr/local/bin/ \
	&& rm /tmp/req.txt

# pwsh wants a home it can write, and the run is as the host user.
ENV HOME=/tmp POWERSHELL_TELEMETRY_OPTOUT=1 POWERSHELL_UPDATECHECK=Off DOTNET_CLI_TELEMETRY_OPTOUT=1
