#!/usr/bin/env bash

##	- Purpose: Local merge gate. The stand-in for a hosted CI: nothing reaches the
##	  release branch (main) unverified, even without a full cicd run.
##	- Behavior (per push ref):
##	   - push to main         -> run the gate (format-check + lints + tests,
##	     fail-fast, nothing mutated). A failure blocks the push. Which gate depends
##	     on the box: `cicd/cicd.bash --gate` on unix, `cicd-win.ps1 -Gate` on a
##	     Windows checkout, where cicd.bash has no docker to build in.
##	   - push to main         -> also a version-bump guard: source/meson.build must
##	     be a strict version increase over what's already on main, and (once one
##	     exists) the README "Release-<ver>" badge must match. So a release merge
##	     can't ship the same-or-lower version.
##	   - any other branch     -> not gated. dev included: a chunk is built and
##	     tested before it is merged there, and a full run's own publish would
##	     only repeat the checks it just made.
##	- Skips: first push of a ref, branch deletes.
##	- Override: `git push --no-verify`, or SKIP_GATE=1.
##	- Install: cicd/hooks/install.bash (copies this to .git/hooks/pre-push).

##	Copyright © 2026 t00mietum (CryptogID: ปʬϝღถɔ4რఠΔթะ9ƾǝu)
##	Licensed under The MIT License (MIT). Full text at:
##		https://mit-license.org/
##	SPDX-License-Identifier: MIT


set -Eeuo pipefail

## meson.build: first `version : '...'`.
## The lookbehind matters: without it `meson_version` on the same project() line
## matches first, and only the field order would keep it right.
_ver_from(){ grep -oP "(?<![_[:alnum:]])version\s*:\s*'\K[^']+" "$1" 2>/dev/null | head -1; }

## Returns 0 when $2 is a strict increase over $1, 1 when they are equal and 2
## when $2 is lower. Map '-' to '~' first (as package.bash does) so a
## prerelease sorts BELOW its release - plain sort -V puts 1.0.0-beta2 after
## 1.0.0, which wrongly blocked the beta->final push.
fVersionOrder(){
	[[ "$1" == "$2" ]] && return 1
	local top
	top="$(printf '%s\n%s\n' "${1//-/\~}" "${2//-/\~}" | sort -V | tail -1)"
	[[ "$top" == "${2//-/\~}" ]] && return 0
	return 2
}

## Sourced by cicd/hooks/test-pre-push.bash for the two functions above.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

[[ "${SKIP_GATE:-0}" == "1" ]] && exit 0

root="$(git rev-parse --show-toplevel)"
z="0000000000000000000000000000000000000000"

gate_ran=0
run_gate(){ ((gate_ran)) && return 0; gate_ran=1
	## cicd.bash builds in a container, so on Windows it would find no docker,
	## skip, and pass without having built anything. Use the native pipeline there.
	case "$(uname -s)" in
		MINGW*|MSYS*|CYGWIN*)
			echo "[ pre-push gate: cicd-win.ps1 -Gate ]"
			pwsh -NoProfile -File "${root}/cicd/cicd-win.ps1" -Gate -Yes
			;;
		*)
			echo "[ pre-push gate: cicd.bash --gate ]"
			"${root}/cicd/cicd.bash" --gate
			;;
	esac
}

## git feeds "<localref> <localsha> <remoteref> <remotesha>" lines on stdin.
while read -r _ localsha remoteref remotesha; do
	[[ "$localsha" == "$z" ]] && continue          # branch delete: skip
	branch="${remoteref#refs/heads/}"
	case "$branch" in
		main) run_gate ;;
		*) continue ;;
	esac

	## Version-bump guard: main only, and only when main already has a version to
	## compare against (skips the very first push to main).
	if [[ "$branch" == "main" && "$remotesha" != "$z" ]]; then
		newver="$(_ver_from "${root}/source/meson.build")"
		oldver="$(git show "${remotesha}:source/meson.build" 2>/dev/null | _ver_from /dev/stdin || true)"
		if [[ -n "$oldver" && -n "$newver" ]]; then
			order=0
			fVersionOrder "$oldver" "$newver" || order=$?
			if [[ "$order" == "1" ]]; then
				echo "FAILED: push to main does not bump the version (still ${newver}); bump source/meson.build on dev first" >&2
				exit 1
			fi
			[[ "$order" == "0" ]] || { echo "FAILED: main version ${newver} is not greater than ${oldver}" >&2; exit 1; }
		fi
		## README release badge must match (once such a badge exists). shields.io
		## escapes '-' as '--'. No badge yet = nothing to enforce (first release adds it).
		if grep -q "Release-[^ )]*-" "${root}/README.md" 2>/dev/null; then
			badge_ver="${newver//-/--}"
			grep -q "Release-${badge_ver}-" "${root}/README.md" || { echo "FAILED: README release badge != ${newver}; update it on dev before the release merge" >&2; exit 1; }
		fi
	fi
done

exit 0
